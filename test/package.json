    "test:connection": "mocha --exit test/connection-mode.spec.js",
    "seed:admin": "node test/scripts/seed-admin.js"
  },
  "dependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "chai": "^4.5.0",
    "firebase": "^10.12.2",
    "firebase-admin": "^14.5.1",
    "mocha": "^10.4.0"
  }
}
